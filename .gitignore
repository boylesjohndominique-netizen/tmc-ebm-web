# =========================
# Laravel (backend/)
# =========================
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/vendor/

# Keep the directory tree, ignore all generated runtime contents
/backend/storage/**/*
!/backend/storage/**/
!/backend/storage/**/.gitignore
!/backend/storage/**/.gitkeep

/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/public/storage
/backend/public/hot

# =========================
# Frontend (frontend/)
# =========================
/frontend/node_modules/
/frontend/dist/
/frontend/build/
/frontend/.vite/

/frontend/.env
/frontend/.env.*
!/frontend/.env.example

/frontend/*.log

# =========================
# Environment files & general
# =========================
.env
.env.local
.env.*.local

.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.swp
